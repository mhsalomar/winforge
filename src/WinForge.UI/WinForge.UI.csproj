<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WinForge.Core\WinForge.Core.csproj" />
    <ProjectReference Include="..\WinForge.Infrastructure\WinForge.Infrastructure.csproj" />
    <ProjectReference Include="..\WinForge.Localization\WinForge.Localization.csproj" />
    <ProjectReference Include="..\WinForge.Worker\WinForge.Worker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyWorker" AfterTargets="Build">
    <ItemGroup><WorkerFiles Include="..\WinForge.Worker\bin\$(Configuration)\net8.0-windows\WinForge.Worker.*" /></ItemGroup>
    <Copy SourceFiles="@(WorkerFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\catalog\**\*" Link="catalog\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

</Project>
