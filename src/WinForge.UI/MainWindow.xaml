<Window x:Class="WinForge.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WinForge" Width="1180" Height="760" MinWidth="1000" MinHeight="650" WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackground}" Foreground="{StaticResource TextBrush}">
  <Grid FlowDirection="{Binding FlowDirection}"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#0E141C" BorderBrush="#26313D" BorderThickness="0,0,1,0"><DockPanel>
      <StackPanel DockPanel.Dock="Top" Margin="20,22,16,16"><TextBlock Text="WinForge" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Windows, clearly managed" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/></StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="12"><Button Content="العربية / English" Command="{Binding ToggleLanguageCommand}"/><Button Content="Dark / Light" Command="{Binding ToggleThemeCommand}"/></StackPanel>
      <ListBox ItemsSource="{Binding Navigation}" SelectedItem="{Binding SelectedNavigation}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Glyph}" FontSize="16" Width="28"/><TextBlock Text="{Binding Title}" FontSize="14"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    </DockPanel></Border>
    <Grid Grid.Column="1" Margin="26,22,26,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,16"><StackPanel><TextBlock Text="{Binding PageTitle}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding PageDescription}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/></StackPanel><ProgressBar DockPanel.Dock="Right" Width="130" Height="4" IsIndeterminate="True" Visibility="{Binding BusyVisibility}" Foreground="{StaticResource AccentBrush}" Background="#26313D"/></DockPanel>
      <WrapPanel Grid.Row="1" Margin="-4,0,0,14"><Button Content="{Binding PrimaryActionLabel}" Command="{Binding PrimaryActionCommand}" Background="{StaticResource AccentBrush}" Foreground="#07100E"/><Button Content="{Binding SecondaryActionLabel}" Command="{Binding SecondaryActionCommand}" Visibility="{Binding SecondaryVisibility}"/><Button Content="{Binding SupportBundleLabel}" Command="{Binding SupportBundleCommand}" Visibility="{Binding DashboardVisibility}"/><TextBox Width="240" Margin="12,4" Padding="10,7" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="#111923" Foreground="{StaticResource TextBrush}" BorderBrush="#2A3948" ToolTip="Search / بحث"/></WrapPanel>
      <Grid Grid.Row="2">
        <ScrollViewer Visibility="{Binding DashboardVisibility}" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Metrics}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="245" MinHeight="92" Margin="0,0,12,12" Padding="15" Background="{StaticResource SurfaceBrush}" CornerRadius="9" BorderBrush="#26313D" BorderThickness="1"><StackPanel><TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding Value}" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        <DataGrid ItemsSource="{Binding FilteredRows}" Visibility="{Binding TableVisibility}" AutoGenerateColumns="True" SelectionMode="Extended" SelectionUnit="FullRow" RowHeight="36" ColumnHeaderHeight="38" AlternationCount="2" ScrollViewer.CanContentScroll="True"/>
        <Border Visibility="{Binding AboutVisibility}" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="28"><StackPanel><TextBlock Text="WinForge" FontSize="30" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="1.0.0" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,18"/><TextBlock Text="Open-source Windows inspection, cleanup and optimization with typed operations, exact before-state journals, and no telemetry." FontSize="15" TextWrapping="Wrap"/><TextBlock Text="No registry cleaner. No timer myths. No automatic security disabling. No arbitrary PowerShell." Margin="0,16,0,0" Foreground="#F6C177" TextWrapping="Wrap"/></StackPanel></Border>
      </Grid>
      <Border Grid.Row="3" Margin="0,14,0,0" Padding="12,9" Background="#101820" CornerRadius="7"><TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/></Border>
    </Grid>
  </Grid>
</Window>
